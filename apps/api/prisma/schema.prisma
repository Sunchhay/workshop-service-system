// apps/api/prisma/schema.prisma

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────
enum UserRole {
  ADMIN
  STAFF
  VIEWER
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum CartStatus {
  ACTIVE
  CHECKED_OUT
}

enum ItemType {
  SERVICE
  PRODUCT
}

enum PaymentStatus {
  PAID
  UNPAID
  PARTIAL
}

enum SaleStatus {
  COMPLETED
  VOIDED
}

enum PaymentMethod {
  CASH
  ACLEDA
  ABA
  BAKONG
  OTHER
}

enum CommissionStatus {
  NONE
  UNPAID
  PAID
}

enum CustomerType {
  OWNER
  MECHANIC
}

enum ExpenseStatus {
  PAID
  UNPAID
  VOIDED
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String       @map("password_hash")
  imageUrl     String?      @map("image_url")
  role         UserRole     @default(STAFF)
  status       RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  carts          Cart[]
  sales          Sale[]          @relation("SaleCreatedBy")
  voidedSales    Sale[]          @relation("SaleVoidedBy")
  expenses       Expense[]       @relation("ExpenseCreatedBy")
  voidedExpenses Expense[]       @relation("ExpenseVoidedBy")
  referenceBooks ReferenceBook[]

  @@map("users")
}

model Customer {
  id              String       @id @default(cuid())
  name            String
  phone           String
  imageUrl        String?      @map("image_url")
  note            String?
  customerType    CustomerType @default(OWNER) @map("customer_type")
  lastPurchasedAt DateTime?    @map("last_purchased_at")
  status          RecordStatus @default(ACTIVE)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  cartsAsCustomer Cart[] @relation("CartCustomer")
  cartsAsMechanic Cart[] @relation("CartMechanic")

  salesAsCustomer Sale[] @relation("SaleCustomer")
  salesAsMechanic Sale[] @relation("SaleMechanic")

  expensesAsMechanic Expense[]

  @@index([phone])
  @@index([name])
  @@index([customerType])
  @@index([lastPurchasedAt])
  @@index([status])
  @@map("customers")
}

model MachineModel {
  id          String       @id @default(cuid())
  code        String       @unique
  brand       String?
  modelName   String       @map("model_name")
  machineType String?      @map("machine_type")
  year        String?
  description String?
  imageUrl    String?      @map("image_url")
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  servicePrices  ServicePrice[]
  productPrices  ProductPrice[]
  cartItems      CartItem[]
  saleItems      SaleItem[]
  referenceBooks ReferenceBook[]

  @@index([code])
  @@index([brand])
  @@index([modelName])
  @@index([machineType])
  @@map("machine_models")
}

model Service {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  nameEn      String       @map("name_en")
  category    String?
  description String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  servicePrices ServicePrice[]
  cartItems     CartItem[]
  saleItems     SaleItem[]

  @@index([code])
  @@index([name])
  @@index([nameEn])
  @@index([category])
  @@map("services")
}

model ServicePrice {
  id             String       @id @default(cuid())
  serviceId      String       @map("service_id")
  machineModelId String       @map("machine_model_id")
  ownerPrice     Decimal?     @map("owner_price") @db.Decimal(10, 2)
  mechanicPrice  Decimal?     @map("mechanic_price") @db.Decimal(10, 2)
  note           String?
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  service      Service      @relation(fields: [serviceId], references: [id])
  machineModel MachineModel @relation(fields: [machineModelId], references: [id])

  @@unique([serviceId, machineModelId])
  @@index([serviceId])
  @@index([machineModelId])
  @@map("service_prices")
}

model Product {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  nameEn      String?      @map("name_en")
  category    String?
  unit        String?
  description String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  productPrices         ProductPrice[]
  productSupplierPrices ProductSupplierPrice[]
  cartItems             CartItem[]
  saleItems             SaleItem[]

  @@index([code])
  @@index([name])
  @@index([nameEn])
  @@index([category])
  @@index([status])
  @@map("products")
}

model ProductPrice {
  id             String       @id @default(cuid())
  productId      String       @map("product_id")
  machineModelId String       @map("machine_model_id")
  imageUrl       String?      @map("image_url")
  ownerPrice     Decimal?     @map("owner_price") @db.Decimal(10, 2)
  mechanicPrice  Decimal?     @map("mechanic_price") @db.Decimal(10, 2)
  note           String?
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  product      Product      @relation(fields: [productId], references: [id])
  machineModel MachineModel @relation(fields: [machineModelId], references: [id])

  @@unique([productId, machineModelId])
  @@index([productId])
  @@index([machineModelId])
  @@index([status])
  @@map("product_prices")
}

model Supplier {
  id        String       @id @default(cuid())
  name      String
  phone     String?
  imageUrl  String?      @map("image_url")
  note      String?
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  productSupplierPrices ProductSupplierPrice[]
  expenses              Expense[]

  @@index([name])
  @@index([phone])
  @@map("suppliers")
}

model ProductSupplierPrice {
  id            String    @id @default(cuid())
  productId     String    @map("product_id")
  supplierId    String    @map("supplier_id")
  buyingPrice   Decimal   @map("buying_price") @db.Decimal(10, 2)
  currency      String    @default("USD")
  lastUpdatedAt DateTime? @map("last_updated_at")
  note          String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  product  Product  @relation(fields: [productId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@index([productId])
  @@index([supplierId])
  @@map("product_supplier_prices")
}

model Cart {
  id               String     @id @default(cuid())
  customerId       String?    @map("customer_id")
  mechanicId       String?    @map("mechanic_id")
  createdById      String     @map("created_by_id")
  commissionAmount Decimal    @default(0) @map("commission_amount") @db.Decimal(10, 2)
  commissionNote   String?    @map("commission_note")
  status           CartStatus @default(ACTIVE)
  note             String?
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  customer  Customer?  @relation("CartCustomer", fields: [customerId], references: [id])
  mechanic  Customer?  @relation("CartMechanic", fields: [mechanicId], references: [id])
  createdBy User       @relation(fields: [createdById], references: [id])
  items     CartItem[]

  @@index([customerId])
  @@index([mechanicId])
  @@index([createdById])
  @@index([status])
  @@map("carts")
}

model CartItem {
  id             String   @id @default(cuid())
  cartId         String   @map("cart_id")
  itemType       ItemType @map("item_type")
  serviceId      String?  @map("service_id")
  productId      String?  @map("product_id")
  machineModelId String?  @map("machine_model_id")
  nameSnapshot   String   @map("name_snapshot")
  unitPrice      Decimal  @map("unit_price") @db.Decimal(10, 2)
  quantity       Decimal  @default(1) @db.Decimal(10, 2)
  total          Decimal  @db.Decimal(10, 2)
  note           String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  cart         Cart          @relation(fields: [cartId], references: [id])
  service      Service?      @relation(fields: [serviceId], references: [id])
  product      Product?      @relation(fields: [productId], references: [id])
  machineModel MachineModel? @relation(fields: [machineModelId], references: [id])

  @@index([cartId])
  @@index([itemType])
  @@index([serviceId])
  @@index([productId])
  @@index([machineModelId])
  @@map("cart_items")
}

model Sale {
  id               String           @id @default(cuid())
  invoiceNo        String           @unique @map("invoice_no")
  customerId       String?          @map("customer_id")
  mechanicId       String?          @map("mechanic_id")
  createdById      String           @map("created_by_id")
  subtotal         Decimal          @db.Decimal(10, 2)
  grandTotal       Decimal          @map("grand_total") @db.Decimal(10, 2)
  paidAmount       Decimal          @default(0) @map("paid_amount") @db.Decimal(10, 2)
  balanceAmount    Decimal          @default(0) @map("balance_amount") @db.Decimal(10, 2)
  commissionAmount Decimal          @default(0) @map("commission_amount") @db.Decimal(10, 2)
  commissionNote   String?          @map("commission_note")
  commissionStatus CommissionStatus @default(NONE) @map("commission_status")
  commissionPaidAt DateTime?        @map("commission_paid_at")
  paymentStatus    PaymentStatus    @default(UNPAID) @map("payment_status")
  saleStatus       SaleStatus       @default(COMPLETED) @map("sale_status")
  note             String?
  voidReason       String?          @map("void_reason")
  voidedAt         DateTime?        @map("voided_at")
  voidedById       String?          @map("voided_by_id")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  customer  Customer? @relation("SaleCustomer", fields: [customerId], references: [id])
  mechanic  Customer? @relation("SaleMechanic", fields: [mechanicId], references: [id])
  createdBy User      @relation("SaleCreatedBy", fields: [createdById], references: [id])
  voidedBy  User?     @relation("SaleVoidedBy", fields: [voidedById], references: [id])

  items    SaleItem[]
  payments Payment[]

  @@index([invoiceNo])
  @@index([customerId])
  @@index([mechanicId])
  @@index([createdById])
  @@index([paymentStatus])
  @@index([saleStatus])
  @@index([createdAt])
  @@map("sales")
}

model SaleItem {
  id             String   @id @default(cuid())
  saleId         String   @map("sale_id")
  itemType       ItemType @map("item_type")
  serviceId      String?  @map("service_id")
  productId      String?  @map("product_id")
  machineModelId String?  @map("machine_model_id")
  nameSnapshot   String   @map("name_snapshot")
  unitPrice      Decimal  @map("unit_price") @db.Decimal(10, 2)
  quantity       Decimal  @default(1) @db.Decimal(10, 2)
  total          Decimal  @db.Decimal(10, 2)
  note           String?
  createdAt      DateTime @default(now()) @map("created_at")

  sale         Sale          @relation(fields: [saleId], references: [id])
  service      Service?      @relation(fields: [serviceId], references: [id])
  product      Product?      @relation(fields: [productId], references: [id])
  machineModel MachineModel? @relation(fields: [machineModelId], references: [id])

  @@index([saleId])
  @@index([itemType])
  @@index([serviceId])
  @@index([productId])
  @@index([machineModelId])
  @@map("sale_items")
}

model Payment {
  id            String        @id @default(cuid())
  saleId        String        @map("sale_id")
  paymentMethod PaymentMethod @map("payment_method")
  amount        Decimal       @db.Decimal(10, 2)
  referenceNo   String?       @map("reference_no")
  note          String?
  paidAt        DateTime      @map("paid_at")
  createdAt     DateTime      @default(now()) @map("created_at")

  sale Sale @relation(fields: [saleId], references: [id])

  @@index([saleId])
  @@index([paymentMethod])
  @@index([paidAt])
  @@map("payments")
}

model Expense {
  id            String         @id @default(cuid())
  expenseNo     String         @unique @map("expense_no")
  title         String
  category      String?
  amount        Decimal        @db.Decimal(10, 2)
  paymentMethod PaymentMethod? @map("payment_method")
  expenseStatus ExpenseStatus  @default(PAID) @map("expense_status")
  supplierId    String?        @map("supplier_id")
  mechanicId    String?        @map("mechanic_id")
  referenceNo   String?        @map("reference_no")
  imageUrl      String?        @map("image_url")
  note          String?
  expenseDate   DateTime       @map("expense_date")
  createdById   String         @map("created_by_id")
  voidReason    String?        @map("void_reason")
  voidedAt      DateTime?      @map("voided_at")
  voidedById    String?        @map("voided_by_id")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  supplier  Supplier? @relation(fields: [supplierId], references: [id])
  mechanic  Customer? @relation(fields: [mechanicId], references: [id])
  createdBy User      @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  voidedBy  User?     @relation("ExpenseVoidedBy", fields: [voidedById], references: [id])

  @@index([expenseNo])
  @@index([title])
  @@index([category])
  @@index([supplierId])
  @@index([mechanicId])
  @@index([expenseStatus])
  @@index([expenseDate])
  @@index([createdById])
  @@map("expenses")
}

model ReferenceBook {
  id             String       @id @default(cuid())
  title          String
  category       String?
  machineModelId String?      @map("machine_model_id")
  summary        String?
  imageUrl       String?      @map("image_url")
  fileUrl        String?      @map("file_url")
  status         RecordStatus @default(ACTIVE)
  createdById    String       @map("created_by_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  machineModel MachineModel?          @relation(fields: [machineModelId], references: [id])
  createdBy    User                   @relation(fields: [createdById], references: [id])
  sections     ReferenceBookSection[]

  @@index([title])
  @@index([category])
  @@index([machineModelId])
  @@index([status])
  @@index([createdById])
  @@map("reference_books")
}

model ReferenceBookSection {
  id              String   @id @default(cuid())
  referenceBookId String   @map("reference_book_id")
  name            String
  description     String?
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  referenceBook ReferenceBook       @relation(fields: [referenceBookId], references: [id])
  items         ReferenceBookItem[]

  @@index([referenceBookId])
  @@index([name])
  @@index([sortOrder])
  @@map("reference_book_sections")
}

model ReferenceBookItem {
  id                     String   @id @default(cuid())
  referenceBookSectionId String   @map("reference_book_section_id")
  label                  String
  value                  String?
  unit                   String?
  note                   String?
  sortOrder              Int      @default(0) @map("sort_order")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  section ReferenceBookSection @relation(fields: [referenceBookSectionId], references: [id])

  @@index([referenceBookSectionId])
  @@index([label])
  @@index([sortOrder])
  @@map("reference_book_items")
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String?
  type        String   @default("text")
  group       String   @default("general")
  description String?
  isPublic    Boolean  @default(false) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([key])
  @@index([group])
  @@map("settings")
}
